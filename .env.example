STORAGE_BACKEND=json
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PG_SSL=require
PG_POOL_MAX=10
PG_POOL_CONNECTION_TIMEOUT_MS=30000
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=60000
PG_APPLICATION_NAME=milton-crm
PG_STATE_CACHE_TTL_MS=250
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
VPS_DEPLOY_HOST=
VPS_DEPLOY_PORT=22
VPS_DEPLOY_USER=
VPS_DEPLOY_PASSWORD=
VPS_DEPLOY_HOST_FINGERPRINT=
VPS_DEPLOY_PATH=/opt/milton-crm
UPLOAD_DIR=./uploads
RECEIPT_MAX_BYTES=5000000
