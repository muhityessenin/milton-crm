# Copy this file to .env.production on the VPS. Never commit the real file.
# The application reaches PostgreSQL over Docker's private network by service name `db`.
POSTGRES_DB=milton
POSTGRES_USER=milton
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
PGHOST=db
PGPORT=5432
PGDATABASE=milton
PGUSER=milton
PGPASSWORD=CHANGE_ME_TO_THE_SAME_POSTGRES_PASSWORD
PG_SSL=disable
INITIAL_ADMIN_NAME="Milton Owner"
INITIAL_ADMIN_LOGIN=admin@milton.kz
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_PASSWORD

PG_POOL_MAX=10
PG_POOL_CONNECTION_TIMEOUT_MS=30000
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=60000
PG_APPLICATION_NAME=milton-crm-production
PG_STATE_CACHE_TTL_MS=250
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
RECEIPT_MAX_BYTES=5000000

# Conservative defaults for a VPS with at least 4 GB RAM. Lower them on a smaller host.
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_LOG_MIN_DURATION_MS=500

APP_PORT=4173
APP_BIND_ADDRESS=0.0.0.0
DOCKER_IMAGE_NAME=milton-crm:latest
APP_MEMORY_LIMIT=768m
APP_CPU_LIMIT=1.5
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=2.0

# Host directory used by backup-postgres.sh. Copy backups to storage outside this VPS.
BACKUP_DIR=/opt/backups/milton-crm
BACKUP_RETENTION_DAYS=14

# Set to the public domain when using compose.caddy.yaml, for example crm.example.com.
DOMAIN=:80
